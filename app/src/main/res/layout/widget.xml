<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#C8E6C9" android:textSize="13sp" />
    <TextView android:id="@+id/w_time" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_cigs" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFFFFF" android:textSize="14sp" />
    <TextView android:id="@+id/w_money" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#FFEB3B" android:textSize="16sp" android:textStyle="bold" />
</LinearLayout>
